# Copy this file to .env and fill in the values.
# NEVER commit .env — it contains your Discord bot token.

# From the Discord Developer Portal (Bot tab → Token)
DISCORD_TOKEN=

# Bare base URL of your OpenWebUI instance (no trailing slash, no path).
# Running on the same WSL2 host via network_mode: host → use localhost.
OPENWEBUI_URL=http://localhost:8080

# The model id as it appears in OpenWebUI → Workspace → Models. This must be the OpenWebUI
# model that has the house manual attached (display name "Family1"), NOT the Ollama engine
# underneath it. Pointing this at the engine is the single most common way to break the bot:
# it will answer, but without the house manual, so every answer is ungrounded.
#   OpenWebUI model id : ollama-family1:latest   ← this is what goes here
#   Ollama engine       : qwen3.5-4b-tuned       ← Qwen3.5 4B, num_ctx 4096, set in the Modelfile
# The 4B engine occupies a fixed 5,515 MiB and leaves 1.4-2.2 GB of the 3070 Ti's 8 GB free
# depending on what the Windows desktop is holding. The 9.7B `qwen3.5-tuned` fills the card to
# ~7,921 MiB (271 MiB spare, 97% full) and intermittently spills to CPU. See BENCHMARKS.md.
# Verify the exact id at: curl http://localhost:8080/api/models -H "Authorization: Bearer <key>"
OPENWEBUI_MODEL=ollama-family1:latest

# OpenWebUI API key: Settings → Account → API Keys → Generate
# Required when OpenWebUI auth is enabled (the default).
OPENWEBUI_API_KEY=
